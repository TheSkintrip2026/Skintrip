-12 pe-column-sm-12">                  <div class="pe-deck">                                            <div id="pext-0fyyc" class="pe-pirate-cloak    " data-type="heading" data-background-type="none" data-border-enable="false" data-shadow-enable="false" data-text-shadow-enable="false" >              <div class="pe-pirate pe-lg "><h3 id="" class="pe-heading " data-element-animation="" data-scroll-animation=""><p>Preguntas Frecuentes<br></p></h3></div>                                        </div>                                                    <div id="pext-03z8w" class="pe-pirate-cloak    " data-type="text" data-background-type="none" data-border-enable="false" data-shadow-enable="false" data-text-shadow-enable="false" >              <div class="pe-pirate pe-lg "><div id="" class="pe-text " data-element-animation="" data-scroll-animation="">¿Tienes dudas? Te ayudamos aquí.&nbsp;</div></div>                                        </div>                                                    <div id="pext-sep4x" class="pe-pirate-cloak    " data-type="row" data-layout="6-6 6-6 12-12" data-rtl-support="false" data-full-width="false" data-set-height="false" data-vertical-align="top" data-background-type="none" data-border-enable="false" data-shadow-enable="false" >              <div class="pe-pirate pe-lg "><div class="pe-row " id="" data-reverse-lg="false" data-reverse-md="false" data-reverse-sm="false" data-element-animation="" data-scroll-animation="">                    <div class="pe-column pe-column-lg-6 pe-column-md-6 pe-column-sm-12">                  <div class="pe-deck">                                            <div id="pext-qvy8t" class="pe-pirate-cloak    " data-type="accordion" data-background-type="none" data-border-enable="false" data-icon-type="plus" data-nested-support="false" data-icon-position="right" data-shadow-enable="false" >              <div class="pe-pirate pe-lg "><div class="pe-accordion " id="" data-element-animation="" data-scroll-animation="">                                  <div class="pe-accordion-section">      <div class="pe-accordion-handle ">        <div class="pe-title"><div class="pe-title-content"><strong>¿Cómo funciona Skintrip?</strong></div></div>        <div class="pe-toggle active pe-noselect">          <i class="material-icons-round" translate="no">remove</i>        </div>        <div class="pe-toggle inactive pe-noselect">          <i class="material-icons-round" translate="no">add</i>        </div>      </div>      <div class="pe-accordion-panel" style="height: 0;">        <div class="pe-accordion-panel-content">                        <div class="pe-deck">                                            <div id="pext-bfrfm" class="pe-pirate-cloak    " data-type="text" data-background-type="none" data-border-enable="false" data-shadow-enable="false" data-text-shadow-enable="false" >              <div class="pe-pirate pe-lg "><div id="" class="pe-text " data-element-animation="" data-scroll-animation=""><p>En Skintrip, nuestro objetivo es ofrecerte una experiencia de cuidado de la piel personalizada y sin complicaciones. El proceso es sencillo y está diseñado para que encuentres los productos perfectos para ti. Aquí te explicamos cómo funciona:</p><p><br></p><p>Cuestionario Personalizado: Primero, completa nuestro cuestionario en línea. Este breve cuestionario nos permitirá conocer a fondo tu tipo de piel, tus necesidades específicas y tus objetivos de belleza y cuidado.</p><p><br></p><p>Recomendaciones Automáticas: Basándonos en tus respuestas, nuestro sistema generará automáticamente una selección de productos recomendados. Podrás elegir hasta un máximo de cuatro productos de esta lista.</p><p><br></p><p>Entrega a Domicilio: Una vez que hayas hecho tu selección, recibirás los productos elegidos en la puerta de tu casa en pocos días. Cada producto viene acompañado de una muestra.</p><p>Prueba y Decisión: Tendrás la oportunidad de probar primero las muestras incluidas. De esta manera, puedes asegurarte de que cada producto es adecuado para ti antes de decidir quedártelo.</p><p><br></p><p>Devoluciones Gratuitas: Si algún producto no cumple con tus expectativas, simplemente devuélvelo sin costo adicional. Solo te quedas con lo que realmente te encanta.</p></div></div>                                        </div>                                      </div>                    </div>      </div>    </div>                  <div class="pe-accordion-section">      <div class="pe-accordion-handle ">        <div class="pe-title"><div class="pe-title-content"><strong>¿Cómo devuelvo lo que no quiero?&nbsp;</strong></div></div>        <div class="pe-toggle active pe-noselect">          <i class="material-icons-round" translate="no">remove</i>        </div>        <div class="pe-toggle inactive pe-noselect">          <i class="material-icons-round" translate="no">add</i>        </div>      </div>      <div class="pe-accordion-panel" style="height: 0;">        <div class="pe-accordion-panel-content">                        <div class="pe-deck">                                            <div id="pext-lwg8d" class="pe-pirate-cloak    " data-type="text" data-background-type="none" data-border-enable="false" data-shadow-enable="false" data-text-shadow-enable="false" >              <div class="pe-pirate pe-lg "><div id="" class="pe-text " data-element-animation="" data-scroll-animation=""><p>En Skintrip, facilitamos el proceso de devolución para que solo te quedes con los productos que realmente amas. Sigue estos sencillos pasos:</p><p><br></p><p>Prueba las Muestras: Al recibir tu caja, encontrarás los productos que elegiste junto con sus muestras correspondientes. Asegúrate de probar únicamente las muestras y no abrir los productos de tamaño completo.</p><p><br></p><p>Decide y Selecciona: Una vez que hayas probado las muestras, decide cuáles son los mejores productos para tu piel. Los productos que no quieras conservar deben estar sin abrir y en perfecto estado.</p><p>Prepara la Devolución: Dentro de la caja, encontrarás una bolsa especial para devoluciones. Coloca en esta bolsa los productos de tamaño completo que no deseas quedarte.</p><p><br></p><p>Contáctanos: Una vez que hayas preparado los productos para devolución, ponte en contacto con nuestro equipo de atención al cliente. Te proporcionaremos las instrucciones necesarias para completar el proceso de devolución.</p><p><br></p><p>Recuerda, solo se aceptarán devoluciones de productos que estén perfectamente sellados y en perfecto estado. Queremos asegurarnos de que tengas la mejor experiencia posible y encuentres los productos ideales para tu piel sin ningún riesgo.</p></div></div>                                        </div>                                      </div>                    </div>      </div>    </div>                  <div class="pe-accordion-section">      <div class="pe-accordion-handle ">        <div class="pe-title"><div class="pe-title-content">¿En cuánto tiempo me devuelven el dinero de los productos que no quiero?</div></div>        <div class="pe-toggle active pe-noselect">          <i class="material-icons-round" translate="no">remove</i>        </div>        <div class="pe-toggle inactive pe-noselect">          <i class="material-icons-round" translate="no">add</i>        </div>      </div>      <div class="pe-accordion-panel" style="height: 0;">        <div class="pe-accordion-panel-content">                        <div class="pe-deck">                                            <div id="pext-yy3fm" class="pe-pirate-cloak    " data-type="text" data-background-type="none" data-border-enable="false" data-shadow-enable="false" data-text-shadow-enable="false" >              <div class="pe-pirate pe-lg "><div id="" class="pe-text " data-element-animation="" data-scroll-animation=""><p>En Skintrip, queremos que tu experiencia sea lo más sencilla y satisfactoria posible. Aquí te explicamos cómo funciona el proceso de devolución y reembolso:</p><p><br></p><p>Prueba y Selección: Tienes un plazo de 10 días para probar las muestras de los productos en tu piel y decidir con cuáles deseas quedarte.</p><p><br></p><p>Preparación de la Devolución: Si decides devolver algún producto, colócalo en la bolsa de devoluciones que encontrarás en tu caja, asegúrate de que esté sellado y en perfecto estado. Cierra la bolsa, pega la cinta con los datos de devolución y llévala al punto de devolución más cercano.</p><p><br></p><p>Procesamiento del Reembolso: Una vez que recibamos tu devolución y confirmemos que los productos están en perfecto estado, procesaremos tu reembolso. Este proceso puede tardar hasta 7 días hábiles desde el momento en que recibimos los productos devueltos.</p><p><br></p><p>Nuestro objetivo es asegurarnos de que solo pagues por los productos que realmente amas. Si tienes alguna pregunta durante el proceso, nuestro equipo de atención al cliente estará encantado de ayudarte.</p></div></div>                                        </div>                                      </div>                    </div>      </div>    </div>  </div></div>                                        </div>                                      </div>              </div>          <div class="pe-column pe-column-lg-6 pe-column-md-6 pe-column-sm-12">                    <div class="pe-deck">                                            <div id="pext-zgjij" class="pe-pirate-cloak    " data-type="accordion" data-background-type="none" data-border-enable="false" data-icon-type="plus" data-nested-support="false" data-icon-position="right" data-shadow-enable="false" >              <div class="pe-pirate pe-lg "><div class="pe-accordion " id="" data-element-animation="" data-scroll-animation="">                                  <div class="pe-accordion-section">      <div class="pe-accordion-handle ">        <div class="pe-title"><div class="pe-title-content">¿Cómo cancelo mi suscripción?</div></div>        <div class="pe-toggle active pe-noselect">          <i class="material-icons-round" translate="no">remove</i>        </div>        <div class="pe-toggle inactive pe-noselect">          <i class="material-icons-round" translate="no">add</i>        </div>      </div>      <div class="pe-accordion-panel" style="height: 0;">        <div class="pe-accordion-panel-content">                        <div class="pe-deck">                                            <div id="pext-zjvek" class="pe-pirate-cloak    " data-type="text" data-background-type="none" data-border-enable="false" data-shadow-enable="false" data-text-shadow-enable="false" >              <div class="pe-pirate pe-lg "><div id="" class="pe-text " data-element-animation="" data-scroll-animation=""><p>Yes! We ship worldwide.</p><p><br></p><p>Packages leaving the US will be shipped to a regional hub and then to the destination country. Once the packages reach their destination country, they are handed over to the country's local postal service for final delivery. Keep in mind that international orders can take up 3- 8 weeks to be delivered.</p></div></div>                                        </div>                                      </div>                    </div>      </div>    </div>                  <div class="pe-accordion-section">      <div class="pe-accordion-handle ">        <div class="pe-title"><div class="pe-title-content"><strong>¿En cuánto tiempo me llegará mi caja?</strong></div></div>        <div class="pe-toggle active pe-noselect">          <i class="material-icons-round" translate="no">remove</i>        </div>        <div class="pe-toggle inactive pe-noselect">          <i class="material-icons-round" translate="no">add</i>        </div>      </div>      <div class="pe-accordion-panel" style="height: 0;">        <div class="pe-accordion-panel-content">                        <div class="pe-deck">                                            <div id="pext-x0hs9" class="pe-pirate-cloak    " data-type="text" data-background-type="none" data-border-enable="false" data-shadow-enable="false" data-text-shadow-enable="false" >              <div class="pe-pirate pe-lg "><div id="" class="pe-text " data-element-animation="" data-scroll-animation=""><p>En Skintrip, ofrecemos opciones de envío flexibles para adaptarnos a tus necesidades. Puedes elegir entre dos métodos de envío:</p><p><br></p><p>Envío Estándar: Si optas por el envío estándar, tu pedido llegará entre 4 a 5 días hábiles desde el momento en que se procese tu orden. Esta es una excelente opción si no tienes prisa y prefieres un método de envío económico.</p><p><br></p><p>Envío Express: Si necesitas tus productos rápidamente, elige nuestro envío express. Con esta opción, tu pedido llegará en solo 1 a 2 días hábiles. Es ideal para aquellos momentos en los que necesitas comenzar tu rutina de cuidado de la piel lo antes posible.</p><p><br></p><p>Independientemente de la opción que elijas, te mantendremos informado con actualizaciones de seguimiento para que sepas exactamente cuándo esperar tu caja.</p></div></div>                                        </div>                                      </div>                    </div>      </div>    </div>  </div></div>                                        </div>                                                    <div id="pext-dr5do" class="pe-pirate-cloak    " data-type="accordion" data-background-type="none" data-border-enable="false" data-icon-type="plus" data-nested-support="false" data-icon-position="right" data-shadow-enable="false" >              <div class="pe-pirate pe-lg "><div class="pe-accordion " id="" data-element-animation="" data-scroll-animation="">                                  <div class="pe-accordion-section">      <div class="pe-accordion-handle ">        <div class="pe-title"><div class="pe-title-content">¿Qué pasa si no escojo ningún producto de mi caja?</div></div>        <div class="pe-toggle active pe-noselect">          <i class="material-icons-round" translate="no">remove</i>        </div>        <div class="pe-toggle inactive pe-noselect">          <i class="material-icons-round" translate="no">add</i>        </div>      </div>      <div class="pe-accordion-panel" style="height: 0;">        <div class="pe-accordion-panel-content">                        <div class="pe-deck">                                            <div id="pext-dvpsi" class="pe-pirate-cloak    " data-type="text" data-background-type="none" data-border-enable="false" data-shadow-enable="false" data-text-shadow-enable="false" >              <div class="pe-pirate pe-lg "><div id="" class="pe-text " data-element-animation="" data-scroll-animation=""><p>En Skintrip, queremos asegurarnos de que encuentres los productos perfectos para tu piel. Si después de probar las muestras decides no quedarte con ningún producto, tienes dos opciones:</p><p><br></p><p>Solicitar una Nueva Selección: Si no te gustó ningún producto de tu caja, puedes contactarnos y estaremos encantados de enviarte una nueva selección de productos recomendados para que los pruebes.</p><p><br></p><p>Devolución Completa: Si prefieres no cambiar los productos y devolver toda la caja, simplemente devuelve los productos de tamaño completo en la bolsa de devoluciones incluida en tu caja. Asegúrate de que los productos estén sin abrir y en perfecto estado. En este caso, te cobraremos una tarifa de 9 euros que cubrirá los gastos de asesoramiento personalizado y la gestión de la devolución.</p><p><br></p><p>Nuestro objetivo es que encuentres los productos ideales para tu piel, y estamos aquí para ayudarte en cada paso del camino. Si tienes alguna pregunta o necesitas asistencia, no dudes en contactarnos.</p></div></div>                                        </div>                                      </div>                    </div>      </div>    </div>                  <div class="pe-accordion-section">      <div class="pe-accordion-handle ">        <div class="pe-title"><div class="pe-title-content">¿Puedo probar los productos de forma flexible?</div></div>        <div class="pe-toggle active pe-noselect">          <i class="material-icons-round" translate="no">remove</i>        </div>        <div class="pe-toggle inactive pe-noselect">          <i class="material-icons-round" translate="no">add</i>        </div>      </div>      <div class="pe-accordion-panel" style="height: 0;">        <div class="pe-accordion-panel-content">                        <div class="pe-deck">                                            <div id="pext-igbjj" class="pe-pirate-cloak    " data-type="text" data-background-type="none" data-border-enable="false" data-shadow-enable="false" data-text-shadow-enable="false" >              <div class="pe-pirate pe-lg "><div id="" class="pe-text " data-element-animation="" data-scroll-animation=""><p>Sí, porque puedes comprar los productos por una única vez o elegir nuestras suscripciones mensuales o trimestrales, sin ninguna obligación y cancelarla cuando desees.&nbsp;</p></div></div>                                        </div>                                      </div>                    </div>      </div>    </div>  </div></div>                                        </div>                                      </div>                </div>          </div></div>                                        </div>                                      </div>              </div>              </div></div>                                        </div>                      <div id="pext-ag0f2" class="pe-pirate-cloak    " data-type="row" data-layout="4-4-4 4-4-4 12-12-12" data-border-enable="false" data-background-type="color" data-full-width="false" data-vertical-align="top" data-shadow-enable="false" >              <div class="pe-pirate pe-lg "><div class="pe-row " id="" data-reverse-lg="false" data-reverse-md="false" data-reverse-sm="false" data-element-animation="" data-scroll-animation="">                    <div class="pe-column pe-column-lg-4 pe-column