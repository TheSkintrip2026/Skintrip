{{ 'steps.css' | asset_url | stylesheet_tag }}

<style>
  .steps {
    --steps-line-color: {{ section.settings.line_color }};
    --steps-text-color: {{ section.settings.text_color }};
  }
</style>

<div class="steps">
  {%- for i in (1..3) -%}
    {%- assign icon_setting = 'icon_' | append: i -%}
    {%- assign text_setting = 'text_' | append: i -%}
    <div class="steps__item">
       <div class="steps__icon-wrapper">
        {%- if section.settings[icon_setting] != blank -%}
          {{ section.settings[icon_setting] | image_url: width: 128 | image_tag:
            class: 'steps__icon',
            alt: section.settings[text_setting],
            loading: 'lazy'
          }}
        {%- else -%}
          <img src="{{ 'step-' | append: i | append: '.png' | asset_url }}" class="steps__icon" alt="{{ 'custom.steps.alt' | t }} {{ i }}" loading="lazy">
        {%- endif -%}
      </div>
      <p class="steps__text">{{ section.settings[text_setting] }}</p>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Steps",
  "settings": [
    {
      "type": "color",
      "id": "line_color",
      "label": "Color de la línea",
      "default": "#e3b1d2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#f15a24"
    },
    {
      "type": "header",
      "content": "Paso 1"
    },
    {
      "type": "image_picker",
      "id": "icon_1",
      "label": "Icono paso 1"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Texto paso 1",
      "default": "Respondo el test"
    },
    {
      "type": "header",
      "content": "Paso 2"
    },
    {
      "type": "image_picker",
      "id": "icon_2",
      "label": "Icono paso 2"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Texto paso 2",
      "default": "Elijo como recibir mis resultados"
    },
    {
      "type": "header",
      "content": "Paso 3"
    },
    {
      "type": "image_picker",
      "id": "icon_3",
      "label": "Icono paso 3"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Texto paso 3",
      "default": "Empiezo mi experiencia personalizada"
    }
  ],
  "presets": [
    {
      "name": "Steps"
    }
  ]
}
{% endschema %}