{{ 'experience-cards.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


<div class="experience-cards" id="cardsSection">

  {%- for block in section.blocks -%}
    {%- assign is_featured = false -%}
    {%- if block.settings.featured -%}
      {%- assign is_featured = true -%}
    {%- endif -%}

    <div class="experience-card{% if is_featured %} experience-card--featured{% elsif forloop.first %} experience-card--slide-left{% else %} experience-card--slide-right{% endif %}"
      {{ block.shopify_attributes }}>

      <div class="experience-card__image-wrap">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag:
            class: 'experience-card__image',
            alt: block.settings.title,
            loading: 'lazy'
          }}
        {%- else -%}
          <img
            src="{{ 'experience-' | append: forloop.index | append: '.png' | asset_url }}"
            class="experience-card__image"
            alt="{{ block.settings.title }}"
            loading="lazy">
        {%- endif -%}
        <div class="experience-card__image-fade"> </div>
        {%- if is_featured -%}
          <div class="experience-card__badge">
          <i class="fa-solid fa-heart"></i>
           {{ 'custom.experience_cards.recommended_badge' | t }}</div>
        {%- endif -%}
      </div>

      <div class="experience-card__body">
        <h3 class="experience-card__title">{{ block.settings.title }}</h3>
        <p class="experience-card__subtitle">{{ block.settings.subtitle }}</p>
        <ul class="experience-card__features">
          {%- for i in (1..10) -%}
            {%- assign feature = 'feature_' | append: i -%}
            {%- if block.settings[feature] != blank -%}
              <li>{{ block.settings[feature] }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <a href="{{ block.settings.button_link | default: '/#quiz-gWHrq0'}}" class="experience-card__btn">
          {{ block.settings.button_text }}
        </a>
      </div>

    </div>
  {%- endfor -%}

</div>

<script>
(function () {
  const section = document.getElementById('cardsSection');
  if (!section) return;
  const leftCard = section.querySelector('.experience-card--slide-left');
  const rightCard = section.querySelector('.experience-card--slide-right');
  if (!leftCard || !rightCard) return;

  const observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        setTimeout(function () { leftCard.classList.add('visible'); }, 100);
        setTimeout(function () { rightCard.classList.add('visible'); }, 250);
        observer.disconnect();
      }
    });
  }, { threshold: 0.2 });

  observer.observe(section);
})();
</script>

